{
  "name": "@astrocitas/server",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Servidor autohospedado de AstroCitas: API, sincronización, recordatorios 24/7 y reserva pública.",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --no-warnings=ExperimentalWarning scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --no-warnings=ExperimentalWarning dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrocitas/core": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@node-rs/argon2": "^2.0.2",
    "altcha-lib": "^1.3.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "luxon": "^3.7.2",
    "nodemailer": "^7.0.6",
    "otpauth": "^9.4.1",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
