{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstroCitas",
  "version": "../../../package.json",
  "identifier": "app.astrocitas.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AstroCitas",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#000000",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "Agenda de citas local-first",
    "longDescription": "AstroCitas: agenda de citas con recordatorios para negocios de servicios. Local-first, open source y autohospedable.",
    "copyright": "AstroCitas contributors · AGPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "section": "office" }, "rpm": { "release": "1" } },
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "macOS": { "minimumSystemVersion": "10.15" },
    "android": { "minSdkVersion": 24 }
  },
  "plugins": {
    "updater": {
      "pubkey": "REEMPLAZAR_CON_CLAVE_PUBLICA_DE_TAURI_SIGNER",
      "endpoints": ["https://github.com/AstroSoftwareMoon/AstroCitas/releases/latest/download/latest.json"]
    }
  }
}
