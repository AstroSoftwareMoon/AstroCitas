{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "mailto:*" }, { "url": "sms:*" }, { "url": "tel:*" }] },
    "notification:default",
    "process:allow-restart"
  ]
}
