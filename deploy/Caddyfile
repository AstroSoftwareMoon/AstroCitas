# SITE = tu dominio → Caddy obtiene y renueva el certificado HTTPS automáticamente.
# SITE = :80 → sin dominio: se sirve por http en la IP del equipo (red local).
{$SITE} {
	encode zstd gzip
	reverse_proxy astrocitas:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
