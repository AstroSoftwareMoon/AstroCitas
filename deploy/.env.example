# ─── AstroCitas · configuración del servidor ──────────────────────────────
# Tu dominio (debe apuntar a este servidor). Caddy pedirá el certificado HTTPS.
DOMAIN=citas.tudominio.es

# OBLIGATORIO. Secreto de al menos 32 caracteres: firma sesiones y enlaces y cifra
# las credenciales de mensajería. Genera uno con:  openssl rand -hex 32
ASTRO_SECRET=

# Base de datos. Vacío = SQLite en el volumen /data (recomendado para un negocio pequeño).
# DATABASE_URL=postgres://astrocitas:cambia-esta-contraseña@postgres:5432/astrocitas
# POSTGRES_PASSWORD=cambia-esta-contraseña

# Cola de tareas. Vacío = cola en la propia base de datos (sin servicios extra).
# REDIS_URL=redis://redis:6379

# Permitir que cualquiera cree una cuenta (false: solo el administrador invita).
ALLOW_REGISTRATION=false
# CAPTCHA de prueba de trabajo (ALTCHA, autoalojado, sin terceros) en la reserva pública.
CAPTCHA=true
# Avisar en el panel cuando haya una versión nueva (consulta GitHub Releases).
UPDATE_CHECK=true
# Orígenes permitidos para la API (las apps nativas y la PWA). "*" = cualquiera.
CORS_ORIGINS=*
LOG_LEVEL=info
# Fijar versión de la imagen (por defecto latest)
# ASTROCITAS_VERSION=0.1.0
